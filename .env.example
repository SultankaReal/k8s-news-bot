# ── Email delivery — Yandex SMTP ─────────────────────────────────────────────
# Create app-password at: https://id.yandex.ru/security/app-passwords
# (Account → Security → App passwords → Add)
EMAIL_FROM=your@yandex.ru
EMAIL_PASSWORD=your_app_password_here
# EMAIL_TO defaults to EMAIL_FROM (send to yourself)
EMAIL_TO=your@yandex.ru

# ── GPT Researcher — LLM via Ollama (local, no API key needed) ───────────────
RETRIEVER=duckduckgo
FAST_LLM=ollama:mistral:7b
SMART_LLM=ollama:mistral:7b
STRATEGIC_LLM=ollama:mistral:7b
EMBEDDING_PROVIDER=custom
EMBEDDING_MODEL=nomic-embed-text
GPTR_MAX_ITERATIONS=2
GPTR_MAX_SEARCH_RESULTS=6
# Timeout in seconds — mistral:7b on CPU takes 5-15 min per query
GPTR_TIMEOUT=900

# ── Schedule (UTC cron) ──────────────────────────────────────────────────────
# 0 6 * * *  = 06:00 UTC daily  (09:00 MSK)
# 0 7 * * 1  = 07:00 UTC Monday (10:00 MSK)
DAILY_DIGEST_CRON=0 6 * * *
WEEKLY_REPORT_CRON=0 7 * * 1

# ── Cleanup ───────────────────────────────────────────────────────────────────
# Delete GPT Researcher output files older than this many days
GPTR_OUTPUTS_MAX_AGE_DAYS=7

# ── Debug ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Set to 1 to fire the job immediately on container start (for testing)
RUN_DAILY_NOW=0
RUN_WEEKLY_NOW=0
